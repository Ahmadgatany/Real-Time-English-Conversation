GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
CORS_ORIGINS=http://localhost:3000
MAX_AUDIO_BYTES=15728640
MAX_RESPONSE_CHARS=240
RESPONSE_PAUSE_MS=240
VAD_SILENCE_MS=900
VAD_THRESHOLD=7
INTERRUPTION_THRESHOLD=9
IELTS_PART1_QUESTIONS=4
IELTS_PART3_QUESTIONS=4
IELTS_PREPARATION_SECONDS=60
IELTS_LONG_TURN_SECONDS=120
DATABASE_URL=sqlite+aiosqlite:///./conversation.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=10080
ENVIRONMENT=development
SECURE_COOKIES=false
REQUIRE_WEBSOCKET_AUTH=false
REQUEST_RATE_LIMIT=120
REQUEST_RATE_WINDOW_SECONDS=60
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
LOG_LEVEL=INFO